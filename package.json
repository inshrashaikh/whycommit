{
  "name": "whycommit",
  "displayName": "Whycommit",
  "description": "Generates meaningful Git commit messages from your staged changes using Claude, OpenAI, Gemini, Groq, OpenRouter, OpenCode Zen or a local Ollama model.",
  "version": "0.2.0",
  "publisher": "whycommit",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "author": {
    "name": "Shaikh Inshra"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whycommit/whycommit.git"
  },
  "bugs": {
    "url": "https://github.com/whycommit/whycommit/issues"
  },
  "homepage": "https://github.com/whycommit/whycommit#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "SCM Providers",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "git",
    "commit",
    "commit message",
    "conventional commits",
    "ai",
    "llm",
    "claude",
    "anthropic",
    "openai",
    "gemini",
    "groq",
    "openrouter",
    "ollama",
    "opencode"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#12141a",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "whycommit.generate",
        "title": "Whycommit: Generate Commit Message",
        "category": "Whycommit",
        "icon": "$(sparkle)"
      },
      {
        "command": "whycommit.selectProvider",
        "title": "Whycommit: Select Provider",
        "category": "Whycommit",
        "icon": "$(server)"
      },
      {
        "command": "whycommit.setApiKey",
        "title": "Whycommit: Set API Key",
        "category": "Whycommit",
        "icon": "$(key)"
      },
      {
        "command": "whycommit.showOutput",
        "title": "Whycommit: Show Output Log",
        "category": "Whycommit",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "whycommit.generate",
          "when": "scmProvider == 'git' && whycommit.hasRepository",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "whycommit.generate",
          "when": "true"
        },
        {
          "command": "whycommit.selectProvider",
          "when": "true"
        },
        {
          "command": "whycommit.setApiKey",
          "when": "true"
        },
        {
          "command": "whycommit.showOutput",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Whycommit",
      "properties": {
        "whycommit.provider": {
          "type": "string",
          "enum": [
            "auto",
            "rulebased",
            "vscode-lm",
            "anthropic",
            "openai",
            "gemini",
            "groq",
            "openrouter",
            "opencode",
            "ollama",
            "custom"
          ],
          "enumDescriptions": [
            "Auto (free & offline first) - uses rule-based if no key/Ollama, else tries VS Code LM",
            "Rule-based (offline, deterministic, no network) - works with no setup",
            "VS Code Language Models (Copilot) - no API key needed if signed in",
            "Anthropic Claude",
            "OpenAI",
            "Google Gemini through its OpenAI-compatible endpoint",
            "Groq",
            "OpenRouter",
            "OpenCode Zen (https://opencode.ai/zen/v1)",
            "Ollama - runs locally, nothing leaves your machine",
            "Any other OpenAI-compatible endpoint"
          ],
          "default": "auto",
          "description": "Which LLM/provider generates the commit message."
        },
        "whycommit.model": {
          "type": "string",
          "default": "",
          "description": "Model id sent to the provider. Leave empty to use the provider default."
        },
        "whycommit.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the provider API. Leave empty to use the provider default. Use this for OpenAI-compatible gateways, proxies or a remote Ollama host."
        },
        "whycommit.maxDiffTokens": {
          "type": "number",
          "default": 12000,
          "minimum": 500,
          "maximum": 200000,
          "description": "Approximate token budget for the staged diff that is sent to the model. Larger diffs are truncated."
        },
        "whycommit.language": {
          "type": "string",
          "enum": [
            "english",
            "hinglish"
          ],
          "enumDescriptions": [
            "Write the commit message in English",
            "Write the commit message in Hinglish (Romanized Hindi + English)"
          ],
          "default": "english",
          "description": "Language used for the generated commit message."
        },
        "whycommit.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature passed to the provider."
        },
        "whycommit.maxOutputTokens": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "maximum": 8192,
          "description": "Maximum number of tokens the model may use for the commit message."
        },
        "whycommit.recentCommitCount": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "description": "How many recent commit messages are sent as a style reference."
        },
        "whycommit.maxRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "How often a failed request is retried. Rate limits (429) and server errors (5xx) are retried with exponential backoff."
        },
        "whycommit.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Whycommit status bar item."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:scan": "node scripts/security-scan.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^3.2.0"
  }
}
